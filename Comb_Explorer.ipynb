    "                      fD=fD, f_start=min(fs, fD), t_ramp=w_tr.value*1e-3, t_settle=w_ts.value*1e-3, t_fft=w_th.value*1e-3,\n",
    "                      y_seed=w_ys.value*1e-9, x0_from_table=w_x0.value)\n",
